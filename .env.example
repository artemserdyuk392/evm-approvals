# RPC endpoints. Optional: a public default is used when a value is empty,
# but a private endpoint is strongly recommended for the first full scan.
ETHEREUM_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BASE_RPC_URL=
POLYGON_RPC_URL=
BSC_RPC_URL=

# Optional. When set, enables the "spender source not verified" rule via the
# Etherscan v2 API (one key covers all supported chains).
ETHERSCAN_API_KEY=
